# Hermes gateway home: copy to hermes-data/.env.
# API_SERVER_KEY must match HERMES_TOKEN in the stack root .env.
API_SERVER_KEY=

# The API server must bind to all container interfaces so HermesChat can reach
# it over Docker networking. The host-published port remains loopback-only in
# docker-compose.yml.
API_SERVER_HOST=0.0.0.0

# Optional ownership override for shared files.
# HERMES_FS_UID=10000
# HERMES_FS_GID=1001
